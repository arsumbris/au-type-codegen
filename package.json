{
  "name": "@arsumbris/type-codegen",
  "packageManager": "pnpm@11.1.1",
  "engines": { "node": ">=23" },
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "au-type-codegen": "./src/cli.ts"
  },
  "dependencies": {
    "@arsumbris/au-engine-sdk": "link:../au-engine-sdk"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen": "node --experimental-transform-types src/cli.ts"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "ajv": "^8.17.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
